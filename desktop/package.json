{
  "name": "desktop",
  "version": "0.1.0",
  "description": "The Void desktop app",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --target=es2022 --external:electron --outdir=dist",
    "dev": "npm run build && electron .",
    "pack": "electron-builder --dir",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
