# server
PORT=2567

# Postgres (`docker compose up -d` starts it on :5433). Run `npm run migrate -w server` once.
DATABASE_URL=postgres://void@localhost:5432/void

# Signs login tokens; at least 32 characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=dev-only-auth-secret-change-me-at-least-32-characters

# The Tiled map whose "collision" layer the server enforces. Defaults to the one the client ships.
# MAP_FILE=/path/to/office.tmj

# Browser origins allowed to call /auth/* (comma separated).
CORS_ORIGINS=http://localhost:5173

# Reverse proxies in front of the server (so rate limits see real client addresses).
TRUST_PROXY_HOPS=0

# LiveKit (self-hosted via `docker compose up`). Leave empty to disable voice and video.
# LIVEKIT_URL is what the browser connects to. Dev key/secret match docker/livekit.yaml; replace in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-at-least-32-characters

# client (Vite; must be prefixed VITE_ and contain no secrets)
VITE_SERVER_URL=ws://localhost:2567
# How close players must be to hear and see each other, in tiles (default 3).
VITE_PROXIMITY_TILES=3
