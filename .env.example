# server
PORT=2567

# LiveKit (self-hosted via `docker compose up`). Leave empty to disable voice and video.
# LIVEKIT_URL is what the browser connects to. Dev key/secret match docker/livekit.yaml; replace in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-at-least-32-characters

# client (Vite; must be prefixed VITE_ and contain no secrets)
VITE_SERVER_URL=ws://localhost:2567
