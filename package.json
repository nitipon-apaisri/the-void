{
  "name": "the-void",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server",
    "desktop"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:desktop": "npm run dev -w desktop",
    "prepare": "husky",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:osv": "osv-scanner scan source --lockfile=package-lock.json",
    "audit:secrets": "gitleaks detect --redact --verbose",
    "test": "vitest run",
    "typecheck": "tsc -p shared --noEmit && tsc -p client --noEmit && tsc -p server --noEmit && tsc -p desktop --noEmit",
    "assets:import": "node scripts/import-art.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "oxlint"
    ],
    "*.{json,md,html,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
